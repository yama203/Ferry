<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ferry.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ferry.ViewModels"
    Title="Ferry">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- タイトルバー（Mica を上まで敷く） -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE709;" FontSize="14" Foreground="{ThemeResource FerryBlueBrush}" />
                <TextBlock Text="Ferry" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- サイドバー -->
        <Grid Grid.Row="1" Padding="8,0,4,8" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="接続先を検索" QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged" QuerySubmitted="SearchBox_QuerySubmitted" />
                <Button Grid.Column="1" Style="{StaticResource PaneButtonStyle}" ToolTipService.ToolTip="追加" Padding="8,7">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AddMenu" Opening="AddMenu_Opening">
                            <MenuFlyoutItem Text="接続先を追加…" Click="AddServer_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE968;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="フォルダを追加…" Click="AddFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="AddSharedFolderItem" Text="会社の共有にフォルダを追加…" Click="AddSharedFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE716;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="FileZilla から読み込む…" Click="ImportFileZilla_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="WinSCP から読み込む…" Click="ImportWinScp_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="設定…" Click="Settings_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <ListView x:Name="ServerList" Grid.Row="1" ItemsSource="{x:Bind Sidebar.Rows}" SelectionMode="Extended"
                      SelectionChanged="ServerList_SelectionChanged" ContextRequested="ServerList_ContextRequested"
                      CanDragItems="True" DragItemsStarting="ServerList_DragItemsStarting">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="Padding" Value="8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SidebarRow">
                        <Grid>
                            <!-- フォルダの見出し（接続先をドラッグして移せる） -->
                            <Grid Visibility="{x:Bind IsHeader}" Padding="0,10,0,2" ColumnSpacing="6" AllowDrop="True"
                                  Background="Transparent" DragOver="Header_DragOver" Drop="Header_Drop">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind ChevronGlyph}" FontSize="9" Opacity="{x:Bind ChevronOpacity}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <FontIcon Grid.Column="1" Glyph="&#xE716;" FontSize="12" Visibility="{x:Bind IsShared}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <!-- 接続先 -->
                            <Grid Visibility="{x:Bind IsServer}" Padding="4,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind ServerGlyph}" FontSize="15" Foreground="{ThemeResource FerryBlueBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Row="1" Text="見つかりません" HorizontalAlignment="Center" Margin="0,80,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind Sidebar.IsSearchEmpty, Mode=OneWay}" />

            <!-- Ferry のマークと保存場所 -->
            <Grid Grid.Row="2" Padding="8,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource FerryBlueBrush}">
                    <FontIcon Glyph="&#xE709;" FontSize="14" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="Ferry" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{x:Bind Sidebar.StorageDescription, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               ToolTipService.ToolTip="{x:Bind Sidebar.StorageDescription, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 右: 開いている接続先 -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 更新のお知らせ -->
            <InfoBar x:Name="UpdateBar" Grid.Row="0" VerticalAlignment="Top" Severity="Informational" Title="新しいバージョンがあります" IsOpen="False" Margin="12,0,12,8">
                <InfoBar.ActionButton>
                    <Button Content="再起動して更新" Click="ApplyUpdate_Click" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- パスワードの同期にマスターパスワードが必要 -->
            <InfoBar x:Name="VaultBar" Grid.Row="0" Severity="Warning" Title="パスワードの同期" IsOpen="False" Margin="12,0,12,8"
                     Message="他の PC で設定されたパスワードの同期があります。マスターパスワードを入力すると、この PC でも使えます。">
                <InfoBar.ActionButton>
                    <Button Content="設定を開く" Click="OpenPasswordSettings_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <ContentPresenter x:Name="SessionHost" Grid.Row="1" />
            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE968;" FontSize="40" Foreground="{ThemeResource FerryBlueBrush}" />
                <TextBlock Text="左の一覧から接続先を選んでください" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="接続先を追加…" HorizontalAlignment="Center" Click="AddServer_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
