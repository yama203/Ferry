<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Ferry</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <!-- MSIX にせず普通の exe として配る（Velopack でまとめる） -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- これが無いと publish に Ferry.pri（画面の XAML の情報）が入らず、起動時に XAML の読み込みに失敗する -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Ferry</AssemblyName>
    <Version>0.1.3</Version>
    <ApplicationIcon>Assets\Ferry.ico</ApplicationIcon>
    <!-- 画面は日本語だけなので、ライブラリの他の言語のリソースは入れない（配布の大きさを減らす） -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- Velopack の起動処理を一番最初に呼ぶため、Main は Program.cs に自分で書く -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Ferry.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ferry.Core\Ferry.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!--
      Windows App SDK は使う部品だけを入れる（まとめのパッケージ Microsoft.WindowsAppSDK にすると
      使わない AI・ML・検索・ウィジェットの部品（onnxruntime など 50MB 近く）まで同梱される）
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
