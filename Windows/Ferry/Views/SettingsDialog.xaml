<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Ferry.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="設定"
    PrimaryButtonText="保存"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <!-- 左に縦のタブ（横に並べると幅に入りきらず、横にスクロールしないと出てこなかった）、右に中身 -->
    <Grid Width="660" Height="440" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="Tabs" SelectionMode="Single" SelectionChanged="Tabs_SelectionChanged" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Padding" Value="10,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE716;" FontSize="16" />
                <TextBlock Text="会社の共有" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE753;" FontSize="16" />
                <TextBlock Text="保存場所" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE72E;" FontSize="16" />
                <TextBlock Text="パスワード" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE71C;" FontSize="16" />
                <TextBlock Text="除外" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE70F;" FontSize="16" />
                <TextBlock Text="エディタ" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                <TextBlock Text="通知" VerticalAlignment="Center" />
            </StackPanel>
        </ListView>

        <Grid Grid.Column="1">
            <!-- 会社の共有 -->
            <ScrollViewer x:Name="SharedPage">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <TextBlock Text="会社の共有" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Dropbox などの共有フォルダに接続先を置くと、会社の人と同じ一覧を使えます（Mac 版と同じ形式）。パスワードは「パスワード」で会社のマスターパスワードを決めると、暗号化して共有できます。" />
                    <TextBlock x:Name="SharedPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="共有フォルダを選択…" Click="ChooseShared_Click" />
                        <Button x:Name="StopSharingButton" Content="共有をやめる" Click="StopSharing_Click" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="共有をやめても、共有フォルダのファイルは消えません。" />
                </StackPanel>
            </ScrollViewer>

            <!-- 自分の接続先の保存場所 -->
            <ScrollViewer x:Name="StoragePage" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <TextBlock Text="自分の接続先の保存場所" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="自分だけの接続先と、同期するパスワードを置く場所です。iCloud Drive や、自分だけの Dropbox・OneDrive のフォルダを選ぶと、他の PC（Mac 版も）と同期します。同じ場所を選んだ PC 同士で同じ一覧になります。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="StorageIcon" FontSize="16" Foreground="{ThemeResource FerryBlueBrush}" />
                        <TextBlock x:Name="StorageText" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxWidth="420"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="フォルダを選択…" Click="ChooseStorage_Click" />
                        <Button x:Name="UseICloudButton" Content="iCloud Drive にする" Click="UseICloud_Click" />
                        <Button x:Name="UseLocalButton" Content="この PC だけにする" Click="UseLocal_Click" />
                    </StackPanel>
                    <TextBlock x:Name="StorageNote" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="変えると、新しい場所に一覧が無ければ今の一覧とパスワードの保管庫をコピーします（すでにあればそちらを使います）。保存すると、Ferry を再起動して切り替えます。" />
                </StackPanel>
            </ScrollViewer>

            <!-- パスワード -->
            <ScrollViewer x:Name="PasswordsPage" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <TextBlock Text="パスワードの同期" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel x:Name="VaultsPanel" Spacing="24" />
                </StackPanel>
            </ScrollViewer>

            <!-- 除外 -->
            <ScrollViewer x:Name="ExcludePage" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="0,0,12,0">
                    <TextBlock Text="除外" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="フォルダを転送・同期するときに含めないファイル名（1 行に 1 つ。* と ? が使えます）。直接選んだ項目には適用しません。" />
                    <TextBox x:Name="ExcludeBox" AcceptsReturn="True" Height="260" FontFamily="Consolas" TextWrapping="NoWrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <HyperlinkButton Content="既定に戻す" Click="ResetExclude_Click" Padding="0" />
                </StackPanel>
            </ScrollViewer>

            <!-- エディタ -->
            <ScrollViewer x:Name="EditorPage" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <TextBlock Text="エディタ" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="サーバーのファイルを右クリックの「エディタで開く」で開くアプリ。保存するたびにサーバーへアップロードします。" />
                    <TextBlock x:Name="EditorNameText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="EditorPathText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="エディタを選択…" Click="ChooseEditor_Click" />
                        <Button x:Name="ResetEditorButton" Content="VS Code に戻す" Click="ResetEditor_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 通知 -->
            <ScrollViewer x:Name="NotificationsPage" Visibility="Collapsed">
                <StackPanel Spacing="12" Padding="0,0,12,0">
                    <TextBlock Text="通知" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ToggleSwitch x:Name="NotifySwitch" Header="転送・同期が終わったら通知する"
                                  OnContent="通知する" OffContent="通知しない" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="1 回の操作で始めた転送が全部終わったときに、まとめて 1 回通知します。エディタの保存による自動アップロードでは通知しません。" />
                    <HyperlinkButton Content="通知を試す" Click="TestNotification_Click" Padding="0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
