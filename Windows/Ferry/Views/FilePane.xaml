<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ferry.Views.FilePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Ferry.Models"
    xmlns:vm="using:Ferry.ViewModels">

    <UserControl.Resources>
        <!-- ローカル側: 名前・サイズ・更新日 -->
        <DataTemplate x:Key="LocalTemplate" x:DataType="models:FileEntry">
            <Grid Opacity="{x:Bind Opacity}" Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource FerryBlueBrush}" />
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right" Margin="0,0,12,0"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind DateText}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <!-- サーバー側: 名前・サイズ・更新日・権限 -->
        <DataTemplate x:Key="RemoteTemplate" x:DataType="models:FileEntry">
            <Grid Opacity="{x:Bind Opacity}" Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource FerryBlueBrush}" />
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" HorizontalAlignment="Right" Margin="0,0,12,0"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind DateText}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{x:Bind PermissionsText}" VerticalAlignment="Center" FontFamily="Consolas"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <Grid x:Name="HeaderGrid" Padding="10,6" CornerRadius="8,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="SideIcon" FontSize="16" Margin="2,0,8,0" Foreground="{ThemeResource FerryBlueBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SideLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource PaneButtonStyle}" Click="Back_Click" IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        ToolTipService.ToolTip="戻る（Alt+←）">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource PaneButtonStyle}" Click="Up_Click" IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                        ToolTipService.ToolTip="上のフォルダへ（Alt+↑）">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource PaneButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="再読み込み（F5）">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource PaneButtonStyle}" ToolTipService.ToolTip="その他">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="PaneMenu" Opening="PaneMenu_Opening">
                            <ToggleMenuFlyoutItem x:Name="HiddenToggle" Text="隠しファイルを表示" Click="HiddenToggle_Click" />
                            <MenuFlyoutItem Text="新規フォルダ…" Click="NewFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator x:Name="LocalSeparator" />
                            <MenuFlyoutItem x:Name="ChooseFolderItem" Text="フォルダを選択…" Click="ChooseFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="ExplorerWindowsItem" Text="エクスプローラーで開いているフォルダ" />
                            <MenuFlyoutItem x:Name="OpenInExplorerItem" Text="このフォルダをエクスプローラーで開く" Click="OpenInExplorer_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- パンくず -->
        <BreadcrumbBar Grid.Row="1" x:Name="Breadcrumb" Margin="12,2,12,6" ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
                       ItemClicked="Breadcrumb_ItemClicked" />
        <!-- 項目のテンプレートは使わない（幅が足りないときの「…」の項目に null が渡されて x:Bind が落ちるため）。表示は Crumb.ToString -->


        <!-- 列の見出し（押すと並べ替え） -->
        <Grid Grid.Row="2" Padding="16,0,16,2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition x:Name="PermissionsColumn" Width="84" />
            </Grid.ColumnDefinitions>
            <Button x:Name="NameHeader" Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortName_Click" Content="名前" />
            <Button x:Name="SizeHeader" Grid.Column="1" Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortSize_Click"
                    HorizontalContentAlignment="Right" Content="サイズ" Padding="4,2,12,2" />
            <Button x:Name="DateHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortDate_Click" Content="更新日" />
            <TextBlock x:Name="PermissionsHeader" Grid.Column="3" Text="権限" FontSize="12" Margin="4,0" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- 一覧 -->
        <ListView Grid.Row="3" x:Name="List" SelectionMode="Extended" ItemsSource="{x:Bind ViewModel.VisibleEntries, Mode=OneWay}"
                  DoubleTapped="List_DoubleTapped" KeyDown="List_KeyDown" PreviewKeyDown="List_PreviewKeyDown" ContextRequested="List_ContextRequested"
                  SelectionChanged="List_SelectionChanged" Padding="0,2"
                  CanDragItems="True" DragItemsStarting="List_DragItemsStarting"
                  AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop" />
        <ProgressBar Grid.Row="3" IsIndeterminate="True" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!-- 下: エラーと件数 -->
        <StackPanel Grid.Row="4">
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     CloseButtonClick="ErrorBar_Closed" Margin="8,0,8,4" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Margin="14,4,14,8"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
