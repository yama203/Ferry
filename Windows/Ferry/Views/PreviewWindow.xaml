<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ferry.Views.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="プレビュー">

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="16,0,140,0">
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Margin="12,0,12,12" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer x:Name="ImageView" ZoomMode="Enabled" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Image x:Name="ImageControl" Stretch="Uniform" />
            </ScrollViewer>
            <ScrollViewer x:Name="TextView" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="16,12">
                <TextBlock x:Name="TextControl" FontFamily="Consolas, BIZ UDGothic, Meiryo" FontSize="13" IsTextSelectionEnabled="True" />
            </ScrollViewer>
            <WebView2 x:Name="WebView" Visibility="Collapsed" />
            <StackPanel x:Name="InfoView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon x:Name="InfoIcon" FontSize="48" Foreground="{ThemeResource FerryBlueBrush}" />
                <TextBlock x:Name="InfoName" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="InfoDetail" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
            <ProgressRing x:Name="Loading" IsActive="False" />
        </Grid>
    </Grid>
</Window>
