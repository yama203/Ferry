<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ferry.Views.SessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ferry.Views"
    xmlns:vm="using:Ferry.ViewModels">

    <Grid Padding="12,0,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True">
                <AppBarButton Label="アップロード" Click="Upload_Click" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                              ToolTipService.ToolTip="左で選んだ項目を、サーバー側で開いているフォルダへ">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE898;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="ダウンロード" Click="Download_Click" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                              ToolTipService.ToolTip="右で選んだ項目を、この PC で開いているフォルダへ">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="同期" Click="Sync_Click" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                              ToolTipService.ToolTip="左右で開いているフォルダを比べて同期する">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="ブックマーク" ToolTipService.ToolTip="左右の場所の組み合わせ">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A4;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="BookmarkMenu" Opening="BookmarkMenu_Opening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="EditingButton" Label="編集中" Visibility="Collapsed" ToolTipService.ToolTip="エディタで開いているサーバーのファイル">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="EditingMenu" Opening="EditingMenu_Opening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="再接続" Click="Reconnect_Click" ToolTipService.ToolTip="接続し直す">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="接続設定" Click="Edit_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- 左右のペイン -->
        <Grid Grid.Row="1" x:Name="PanesGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <ContentPresenter x:Name="LocalHost" />

            <views:PaneSplitter Grid.Column="1" x:Name="Splitter" PointerPressed="Splitter_PointerPressed"
                                PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased"
                                PointerCaptureLost="Splitter_PointerCaptureLost" DoubleTapped="Splitter_DoubleTapped"
                                ToolTipService.ToolTip="ダブルクリックで半分ずつに戻す" />

            <Grid Grid.Column="2">
                <ContentPresenter x:Name="RemoteHost" Visibility="{x:Bind ViewModel.ShowRemotePane, Mode=OneWay}" />

                <!-- 接続していないときはサーバー側に状態を出す -->
                <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.ShowStatusPanel, Mode=OneWay}">

                    <!-- 接続中 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsConnecting, Mode=OneWay}" />
                        <TextBlock Text="接続しています…" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- パスワード入力 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="320"
                                Visibility="{x:Bind ViewModel.ShowPasswordPrompt, Mode=OneWay}">
                        <FontIcon Glyph="&#xE72E;" FontSize="32" Foreground="{ThemeResource FerryBlueBrush}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap">
                            <Run Text="{x:Bind ViewModel.Title, Mode=OneWay}" /><Run Text=" に接続" />
                        </TextBlock>
                        <TextBlock x:Name="PasswordMessage" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <PasswordBox x:Name="PasswordInput" Header="{x:Bind ViewModel.PasswordLabel, Mode=OneWay}" KeyDown="PasswordInput_KeyDown" />
                        <CheckBox x:Name="SavePasswordCheck" Content="この PC に保存する" IsChecked="True" />
                        <Button Content="接続" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SubmitPassword_Click" />
                    </StackPanel>

                    <!-- 証明書を確認できない -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420" Margin="24"
                                Visibility="{x:Bind ViewModel.ShowCertificatePrompt, Mode=OneWay}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="証明書を確認できません" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="共用サーバーでは、証明書の名前が接続先のホスト名と合わないことがあります。接続先に間違いがなければ、検証せずに接続できます（通信は暗号化されます）。" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="証明書を検証せずに接続" Style="{StaticResource AccentButtonStyle}" Click="TrustCertificate_Click" />
                            <Button Content="接続設定" Click="Edit_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 接続できない -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420" Margin="24"
                                Visibility="{x:Bind ViewModel.ShowFailure, Mode=OneWay}">
                        <FontIcon Glyph="&#xE783;" FontSize="32" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="接続できませんでした" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="再試行" Style="{StaticResource AccentButtonStyle}" Click="Reconnect_Click" />
                            <Button Content="接続設定" Click="Edit_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 転送一覧（転送があるときだけ） -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ViewModel.Transfers.HasItems, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Padding="12,4,6,4" ColumnSpacing="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="転送" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Transfers.SummaryText, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                <Button Grid.Column="2" Content="完了した項目を消去" Style="{StaticResource PaneButtonStyle}" FontSize="12" Click="ClearFinished_Click" />
                <Button Grid.Column="3" Content="すべて中止" Style="{StaticResource PaneButtonStyle}" FontSize="12" Click="CancelAll_Click" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Transfers.Items}" SelectionMode="None" MaxHeight="190">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransferItem">
                        <Grid ColumnSpacing="10" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource FerryBlueBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Visibility="{x:Bind IsProgressVisible, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Style="{StaticResource PaneButtonStyle}" Click="CancelItem_Click" ToolTipService.ToolTip="中止"
                                        Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource PaneButtonStyle}" Click="RetryItem_Click" ToolTipService.ToolTip="再試行"
                                        Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
