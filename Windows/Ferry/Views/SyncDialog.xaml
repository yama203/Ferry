<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Ferry.Views.SyncDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ferry.Views"
    Title="同期"
    PrimaryButtonText="比較"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    SecondaryButtonClick="Secondary_Click">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid Width="740" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="380" />
        </Grid.RowDefinitions>

        <!-- 送信元・送信先（矢印を押すと方向を切り替え） -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SourceCard" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="送信元" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SourceIcon" FontSize="18" Foreground="{ThemeResource FerryBlueBrush}" />
                        <TextBlock x:Name="SourcePlace" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="SourcePath" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Button Grid.Column="1" x:Name="SwapButton" Click="Swap_Click" VerticalAlignment="Center" Padding="14,10"
                    ToolTipService.ToolTip="方向を切り替える" Style="{StaticResource AccentButtonStyle}">
                <FontIcon Glyph="&#xE72A;" FontSize="16" />
            </Button>
            <Border Grid.Column="2" Padding="14,10" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="送信先" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="DestinationIcon" FontSize="18" Foreground="{ThemeResource FerryBlueBrush}" />
                        <TextBlock x:Name="DestinationPlace" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="DestinationPath" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ミラーと除外 -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ToggleSwitch x:Name="MirrorSwitch" Header="ミラー" OffContent="送信先のファイルは消さない" OnContent="送信先にしかないものを削除する"
                              Toggled="Mirror_Toggled" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="除外" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ExcludeText" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
            </StackPanel>
        </Grid>

        <!-- 比較の結果 -->
        <Grid Grid.Row="2" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">

            <StackPanel x:Name="HintView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460">
                <FontIcon Glyph="&#xE8AB;" FontSize="32" Foreground="{ThemeResource FerryBlueBrush}" />
                <TextBlock Text="比較して確認" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="「比較」を押すと、転送するファイルの一覧を確認できます。サイズが違うか、送信元の方が新しいファイルを転送します。" />
            </StackPanel>

            <StackPanel x:Name="ScanningView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <ProgressRing x:Name="ScanningRing" />
                <TextBlock Text="フォルダを調べています…" HorizontalAlignment="Center" />
                <TextBlock x:Name="ScannedText" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel x:Name="FailedView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460" Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="比較できませんでした" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="FailedText" TextWrapping="Wrap" TextAlignment="Center" IsTextSelectionEnabled="True" />
            </StackPanel>

            <StackPanel x:Name="SyncedView" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE930;" FontSize="36" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock Text="同期済みです" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="SyncedText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid x:Name="ReviewView" Visibility="Collapsed" Padding="10" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 新規・変更・削除・転送量（押すと絞り込み） -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="NewTile" HorizontalAlignment="Stretch" Click="Tile_Click" Tag="New" />
                    <ToggleButton x:Name="ChangedTile" Grid.Column="1" HorizontalAlignment="Stretch" Click="Tile_Click" Tag="Changed" />
                    <ToggleButton x:Name="DeletedTile" Grid.Column="2" HorizontalAlignment="Stretch" Click="Tile_Click" Tag="Deleted" />
                    <Border Grid.Column="3" CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="BytesText" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="転送量" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ListView Grid.Row="1" x:Name="RowsList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="views:SyncRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" Click="RowCheck_Click" />
                                <Border Grid.Column="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Background="{x:Bind BadgeBrush}">
                                    <TextBlock Text="{x:Bind KindText}" FontSize="11" Foreground="White" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{x:Bind Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <HyperlinkButton Content="すべて選択" Click="CheckAll_Click" Padding="4,2" />
                    <HyperlinkButton Grid.Column="1" Content="すべて解除" Click="UncheckAll_Click" Padding="4,2" />
                    <TextBlock Grid.Column="2" x:Name="CheckedText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
